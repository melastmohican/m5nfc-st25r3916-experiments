/* Feather RP2350 Qwiic port: I2C1, SDA GP2, SCL GP3, 400 kHz. Built on rpi_pico2. */
#include <zephyr/dt-bindings/i2c/i2c.h>

&i2c1_default {
	group1 {
		pinmux = <I2C1_SDA_P2>, <I2C1_SCL_P3>;
		input-enable;
		input-schmitt-enable;
	};
};

&i2c1 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
};

&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		/* without this poll_out drops bytes when the TX buffer is full (long dumps lose lines) */
		hw-flow-control;
	};
};

/* Feather RP2350 red LED on GP7: boot/USB progress indicator. */
/ {
	leds_dbg {
		compatible = "gpio-leds";
		dbg_led: dbg_led {
			gpios = <&gpio0 7 GPIO_ACTIVE_HIGH>;
		};
	};
};
